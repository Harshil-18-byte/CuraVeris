APP_ENV=development
APP_SECRET_KEY=generate_with_openssl_rand_hex_32
APP_DEBUG=true
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/curaveris
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=your_r2_access_key
AWS_SECRET_ACCESS_KEY=your_r2_secret
AWS_S3_BUCKET_NAME=curaveris-bills
AWS_S3_REGION=auto
AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com

RESEND_API_KEY=re_xxxx
EMAIL_FROM_ADDRESS=noreply@curaveris.in

EVIDENCE_HMAC_SECRET=generate_with_openssl_rand_hex_32
ML_MODEL_PATH=./ml_models
SENTRY_DSN=
