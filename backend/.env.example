# ==============================================================================
# CURAVERIS (MedBill AI) — ENVIRONMENT CREDENTIALS & SECRETS TEMPLATE
# Copy this file to .env and replace default placeholder keys for deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
ENV=development
DEBUG=True
PROJECT_NAME="CuraVeris - MedBill AI"
API_V1_STR=/api/v1
MAX_UPLOAD_SIZE_MB=20

# ------------------------------------------------------------------------------
# SECURITY, AUTHENTICATION & ENCRYPTION
# ------------------------------------------------------------------------------
# In production/staging: Set to a cryptographically secure 64-character random string
SECRET_KEY=curaveris-dev-only-secret-key-replace-before-any-deployment-2026

# PII Encryption Key: 32 url-safe base64-encoded bytes (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=Y3VyYXZlcmlzLWRldi1vbmx5LWtleS0zMmJ5dGVzLXBhZA==

ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Production: PostgreSQL async driver (asyncpg) and sync driver (psycopg2/default)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/curaveris
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curaveris

# Development Fallback: SQLite
FALLBACK_DATABASE_URL=sqlite+aiosqlite:///./curaveris.db
FALLBACK_SYNC_DATABASE_URL=sqlite:///./curaveris.db
REFERENCE_DB_PATH=./reference_data/medical_rates.db

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_mock_curaveris
RAZORPAY_KEY_SECRET=mock_secret_curaveris_2026
RAZORPAY_WEBHOOK_SECRET=webhook_secret_curaveris_2026

# ------------------------------------------------------------------------------
# HUGGING FACE (MODEL HUB & EMBEDDINGS)
# ------------------------------------------------------------------------------
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_HUB_TOKEN=

# ------------------------------------------------------------------------------
# CLOUD LLM PROVIDERS (OPTIONAL FOR AI NARRATIVE GENERATION)
# ------------------------------------------------------------------------------
# Provide one or more API keys to enable natural-language dispute summaries
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# SUPABASE & CLOUD OBJECT STORAGE
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=curaveris-bills

# ------------------------------------------------------------------------------
# AYUSHMAN BHARAT DIGITAL MISSION (ABDM / ABHA HEALTH ID)
# ------------------------------------------------------------------------------
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS (WHATSAPP CLOUD API)
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=curaveris_whatsapp_verify_token_2026
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

